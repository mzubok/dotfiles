# Keep PATH and fpath free of duplicates (nested shells, `reload!`)
typeset -U path fpath

# Set by `brew shellenv` in .zprofile; fall back for non-login shells
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-$(brew --prefix)}"

# Homebrew completions (incl. zsh-completions) must be in fpath before compinit runs below
fpath=($HOMEBREW_PREFIX/share/zsh-completions $HOMEBREW_PREFIX/share/zsh/site-functions $fpath)

# Change Antidote's home directory
export ANTIDOTE_HOME=~/.cache/antidote

# Init antidote
source $HOMEBREW_PREFIX/share/antidote/antidote.zsh

# Initialize plugins statically with ${ZDOTDIR:-~}/.zsh_plugins.txt
antidote load

# Initialize completions once plugins have added their fpath entries
autoload -Uz compinit && compinit

# Configure atuin
eval "$(atuin init zsh)"

# Configure starship
eval "$(starship init zsh)"

# Set up fzf key bindings (Ctrl-T, Alt-C) and ** fuzzy completion; Ctrl-R stays with atuin
export FZF_CTRL_R_COMMAND=
# Ctrl-T lists files via ripgrep (respects .gitignore and ~/.ripgreprc, includes dotfiles)
export FZF_CTRL_T_COMMAND='rg --files --hidden'
eval "$(fzf --zsh)"

# Default editor; --wait blocks until the file is closed (git commit, rebase -i, crontab -e)
export EDITOR='zed --wait'

# ripgrep only reads a config file when this is set
export RIPGREP_CONFIG_PATH=~/.ripgreprc

# Update Homebrew every 24 hours
export HOMEBREW_AUTO_UPDATE_SECS="86400"
# Hide Homebrew usage hints
export HOMEBREW_NO_ENV_HINTS=1

source ~/.bin/aliases.zsh
source ~/.bin/config.zsh
source ~/.bin/functions.zsh

# Catppuccin Macchiato colours; bg:-1 keeps the terminal background
export FZF_DEFAULT_OPTS=" \
--color=bg+:#363a4f,bg:-1,spinner:#f4dbd6,hl:#ed8796 \
--color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6 \
--color=marker:#b7bdf8,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796 \
--color=selected-bg:#494d64 \
--multi"

# GNU sed and coreutils without the `g` prefix
path=($HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin $HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin $path)
# Unversioned symlinks for python, python-config, pip etc. (only if Homebrew Python is installed)
[[ -d $HOMEBREW_PREFIX/opt/python/libexec/bin ]] && path=($HOMEBREW_PREFIX/opt/python/libexec/bin $path)

# Own scripts first
path=($HOME/.bin $path)

# 1Password SSH Agent
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

# Machine-specific (private) settings; last so they can override anything above
[[ -f ~/.localrc ]] && source ~/.localrc

# THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
